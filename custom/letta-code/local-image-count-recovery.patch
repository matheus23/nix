diff --git a/src/backend/pi-stream-adapter-image-count.test.ts b/src/backend/pi-stream-adapter-image-count.test.ts
new file mode 100644
index 00000000..dfa945d0
--- /dev/null
+++ b/src/backend/pi-stream-adapter-image-count.test.ts
@@ -0,0 +1,194 @@
+import { describe, expect, test } from "bun:test";
+import type {
+  AssistantMessage,
+  AssistantMessageEvent,
+  Context,
+} from "@earendil-works/pi-ai";
+import {
+  elideImagesToCountBudget,
+  providerImageCountConstraint,
+} from "@/backend/dev/pi-image-elision";
+import {
+  PiStreamAdapter,
+  type PiStreamFunction,
+} from "@/backend/dev/pi-stream-adapter";
+import type {
+  ProviderStreamEvent,
+  ProviderTurnInput,
+} from "@/backend/dev/provider-turn-executor";
+import { emptyLocalUsage } from "@/backend/local/local-message";
+
+function assistantMessage(): AssistantMessage {
+  return {
+    role: "assistant",
+    content: [{ type: "text", text: "ok" }],
+    api: "openai-completions",
+    provider: "gufo",
+    model: "qwen3.8-flash-next-q4",
+    usage: emptyLocalUsage(),
+    stopReason: "stop",
+    timestamp: Date.now(),
+  };
+}
+
+function assistantErrorMessage(errorMessage: string): AssistantMessage {
+  return {
+    ...assistantMessage(),
+    content: [],
+    stopReason: "error",
+    errorMessage,
+  };
+}
+
+function streamFromEvents(
+  events: AssistantMessageEvent[],
+  finalMessage: AssistantMessage,
+): ReturnType<PiStreamFunction> {
+  async function* iterator() {
+    for (const event of events) yield event;
+  }
+  return Object.assign(iterator(), {
+    result: async () => finalMessage,
+  });
+}
+
+async function collectEvents(
+  events: AsyncIterable<ProviderStreamEvent>,
+): Promise<ProviderStreamEvent[]> {
+  const collected: ProviderStreamEvent[] = [];
+  for await (const event of events) collected.push(event);
+  return collected;
+}
+
+function input(): ProviderTurnInput {
+  return {
+    conversationId: "local-conv-image-count",
+    agentId: "agent-local-1",
+    agent: {
+      id: "agent-local-1",
+      name: "Local",
+      description: null,
+      system: "system",
+      tags: [],
+      model: "bedrock/us.anthropic.claude-sonnet-4-6",
+      model_settings: { provider_type: "bedrock" },
+    },
+    body: { messages: [] } as never,
+    history: [],
+    uiMessages: [
+      { id: "ui-msg-1", role: "user", content: "hello", timestamp: Date.now() },
+    ],
+    clientTools: [],
+    clientSkills: [],
+  };
+}
+
+function imageBlocks(contextMessages: Context["messages"]): number {
+  return contextMessages.flatMap((message) =>
+    Array.isArray(message.content)
+      ? message.content.filter((part) => part.type === "image")
+      : [],
+  ).length;
+}
+
+function screenshotMessages(images: number) {
+  const messages: ProviderTurnInput["uiMessages"] = [];
+  let remaining = images;
+  let index = 0;
+  while (remaining > 0) {
+    const count = Math.min(6, remaining);
+    remaining -= count;
+    messages.push({
+      id: `ui-msg-shot-${index}`,
+      role: "user",
+      content: Array.from({ length: count }, (_, i) => ({
+        type: "image" as const,
+        mimeType: "image/jpeg",
+        data: `data-${index}-${i}`,
+      })),
+      timestamp: Date.now(),
+    } as ProviderTurnInput["uiMessages"][number]);
+    index += 1;
+  }
+  return messages;
+}
+
+const GUFO_COUNT_REJECTION =
+  'image_url requires a user message and a string URL (at most 16 images) {"error":{"message":"image_url requires a user message and a string URL (at most 16 images)","type":"invalid_request_error","code":"invalid_messages"}}';
+
+describe("provider image count constraint", () => {
+  test("parses the stated limit from Gufo-style rejections", () => {
+    expect(
+      providerImageCountConstraint(new Error(GUFO_COUNT_REJECTION)),
+    ).toEqual({ limit: 16 });
+    expect(
+      providerImageCountConstraint(new Error("Too many images in request")),
+    ).toEqual({ limit: null });
+    expect(
+      providerImageCountConstraint(new Error("429 rate limit exceeded")),
+    ).toBeUndefined();
+  });
+
+  test("keeps newest images and no-ops when the count already fits", () => {
+    const base = input();
+    const withImages = {
+      ...base,
+      uiMessages: [...base.uiMessages, ...screenshotMessages(5)],
+    };
+    const capped = elideImagesToCountBudget(withImages, 3);
+    expect(capped).not.toBeNull();
+    expect(capped?.imagesBefore).toBe(5);
+    expect(capped?.imagesAfter).toBe(3);
+    // Newest 3 images survive: the two oldest blocks became placeholders.
+    const survivors = capped?.input.uiMessages.flatMap((message) =>
+      Array.isArray(message.content)
+        ? message.content.filter((block) => block.type === "image")
+        : [],
+    );
+    expect(survivors?.[0]?.data).toBe("data-0-2");
+    expect(elideImagesToCountBudget(withImages, 5)).toBeNull();
+    expect(elideImagesToCountBudget(base, 3)).toBeNull();
+  });
+
+  test("recovers a turn when the provider rejects the image count", async () => {
+    let providerCalls = 0;
+    const contexts: Context[] = [];
+    const stream: PiStreamFunction = (_model, context) => {
+      providerCalls += 1;
+      contexts.push(context);
+      if (providerCalls === 1) {
+        const error = assistantErrorMessage(GUFO_COUNT_REJECTION);
+        return streamFromEvents(
+          [{ type: "error", reason: "error", error }],
+          error,
+        );
+      }
+      const finalMessage = assistantMessage();
+      return streamFromEvents(
+        [{ type: "done", reason: "stop", message: finalMessage }],
+        finalMessage,
+      );
+    };
+
+    const adapter = new PiStreamAdapter({ stream });
+    const base = input();
+    // Drain the recovered turn to completion.
+    await collectEvents(
+      adapter.stream({
+        ...base,
+        uiMessages: [...base.uiMessages, ...screenshotMessages(18)],
+      }),
+    );
+
+    // The failed 400 must not terminate the turn: the adapter recovers by
+    // eliding the oldest images and re-issuing the request, which succeeds on
+    // the second call. `providerCalls === 2` (not a throw, not a third
+    // attempt) proves both the recovery-retry and clean completion.
+    expect(providerCalls).toBe(2);
+    expect(imageBlocks(contexts[1]?.messages ?? [])).toBeLessThanOrEqual(16);
+    // The retry actually drops at least one image versus the first request.
+    expect(imageBlocks(contexts[0]?.messages ?? [])).toBeGreaterThan(
+      imageBlocks(contexts[1]?.messages ?? []),
+    );
+  });
+});
