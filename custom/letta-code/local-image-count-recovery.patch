+// Letta Code addition (no Pi analog): image COUNT limits. Some providers —
+// notably local OpenAI-compatible servers such as Gufo — reject requests that
+// carry more than N images with a clean, non-retryable HTTP 400
+// (`invalid_messages`, e.g. "(at most 16 images)"). This is orthogonal to the
+// byte-size recovery above: the payload can be ~1 MB and still be rejected,
+// `isContextOverflow` never matches, and `isRetryableLocalProviderError`
+// treats a 400 as terminal, so without help every later turn re-sends the
+// same retained screenshots and the session is permanently bricked. When a
+// provider error states (or implies) an image-count constraint, drop the
+// oldest images from the provider retry context until the request fits,
+// mirroring how oversized-byte elision recovers transport failures. The
+// originals stay in conversation history and can be re-Read later.
+
+/**
+ * Recognizes provider rejections caused by per-request image counts.
+ * Returns the provider-stated limit when the message includes one, `null`
+ * when the message signals an image-count problem without a number, and
+ * `undefined` when the error is unrelated (leave it terminal).
+ */
+export function providerImageCountConstraint(
+  error: unknown,
+): { limit: number | null } | undefined {
+  const detail = localProviderErrorDetail(error);
+  if (!detail) return undefined;
+  const withLimit =
+    detail.match(/at most (\d+) images?/i) ??
+    detail.match(/(?:maximum|max(?:imum)?)\D{0,30}(\d+)\s+images?/i) ??
+    detail.match(/(\d+)\s+images?\s+(?:per request|max)/i) ??
+    detail.match(/image inputs exceed (\d+) images?/i);
+  const parsed = withLimit ? Number(withLimit[1]) : Number.NaN;
+  if (Number.isFinite(parsed) && parsed > 0) {
+    return { limit: Math.floor(parsed) };
+  }
+  if (/\btoo many images\b/i.test(detail)) return { limit: null };
+  return undefined;
+}
+
+function imageCountElisionPlaceholder(mimeType: string | undefined): string {
+  return `[Image omitted from this provider retry: the provider limits how many images a request may carry. The original image remains stored in conversation history.${
+    mimeType ? ` (${mimeType})` : ""
+  }]`;
+}
+
+export interface ImageCountElision {
+  input: ProviderTurnInput;
+  imagesBefore: number;
+  imagesAfter: number;
+  keptImages: number;
+}
+
+/**
+ * Keeps at most `maxImages` images (newest first) in the provider retry
+ * context, replacing older image blocks with text placeholders. Returns null
+ * when nothing exceeds the budget, so callers can distinguish "applied" from
+ * "no change" and never spin on identical retries.
+ */
+export function elideImagesToCountBudget(
+  input: ProviderTurnInput,
+  maxImages: number,
+): ImageCountElision | null {
+  const candidates = imageElisionCandidates(input.uiMessages);
+  const kept = Math.max(0, Math.floor(maxImages));
+  if (candidates.length === 0 || candidates.length <= kept) return null;
+
+  // Candidates are sorted oldest-first; elide from the front, keeping the
+  // newest `kept` images — recent screenshots are what the model needs.
+  let uiMessages = input.uiMessages;
+  for (const candidate of candidates.slice(0, candidates.length - kept)) {
+    uiMessages = elideImagePayload(
+      uiMessages,
+      candidate,
+      imageCountElisionPlaceholder(candidate.mimeType),
+    );
+  }
+  return {
+    input: { ...input, uiMessages },
+    imagesBefore: candidates.length,
+    imagesAfter: kept,
+    keptImages: kept,
+  };
+}
+
+/** Number of provider-eligible image blocks in the request context. */
+export function countImagePayloads(messages: readonly LocalMessage[]): number {
+  return imageElisionCandidates(messages).length;
+}
