@@ -0,0 +1,67 @@
+import type { SessionNotification } from '@agentclientprotocol/sdk';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import type { Message } from '../../types/message';
+import { acpPromptSession } from '../prompt';
+import { acpChatSessionActions, acpChatSessionStore } from '../chatSessionStore';
+import { createAcpSessionNotificationAdapter } from '../sessionNotificationAdapter';
+
+const { requestPrompt } = vi.hoisted(() => ({ requestPrompt: vi.fn().mockResolvedValue({ stopReason: 'end_turn' }) }));
+vi.mock('../acpConnection', () => ({
+  getAcpClient: async () => ({ connection: { agent: { request: requestPrompt } } }),
+}));
+
+function localMessage(id: string, text: string, steer = false): Message {
+  const metadata = { userVisible: true, agentVisible: true, steer, optimistic: true };
+  return { id, role: 'user', created: 123, content: [{ type: 'text', text }], metadata };
+}
+
+function chunk(sessionId: string, id: string, text: string, steer = false): SessionNotification {
+  return { sessionId, update: {
+    sessionUpdate: 'user_message_chunk', messageId: id, content: { type: 'text', text },
+    _meta: { goose: { messageId: id, steer } },
+  } } as SessionNotification;
+}
+
+afterEach(() => {
+  acpChatSessionActions.deleteSnapshot('echo-race');
+  requestPrompt.mockClear();
+});
+
+describe('local user-message echoes', () => {
+  it('sends the optimistic prompt ID to the backend', async () => {
+    await acpPromptSession('echo-race', localMessage('compact-1', '/compact'));
+    expect(requestPrompt.mock.calls[0][1]._meta).toMatchObject({ goose: { messageId: 'compact-1' } });
+  });
+
+  it('reconciles a compact command echo without duplicating its text', () => {
+    const adapter = createAcpSessionNotificationAdapter([localMessage('compact-1', '/compact')]);
+    adapter.apply(chunk('echo-race', 'compact-1', '/com'));
+    adapter.apply(chunk('echo-race', 'compact-1', 'pact'));
+    expect(adapter.getMessages()).toHaveLength(1);
+    expect(adapter.getMessages()[0].content).toEqual([{ type: 'text', text: '/compact' }]);
+  });
+
+  it.each([true, false])('does not treat queue acceptance as echoed text (ack first: %s)', (ackFirst) => {
+    const acknowledge = () => acpChatSessionActions.applyAcpSessionNotification({
+      sessionId: 'echo-race', update: { sessionUpdate: 'session_info_update',
+        _meta: { goose: { queuedSteer: { messageId: 'steer-1', runId: 'run-1' } } },
+      },
+    } as SessionNotification);
+    if (ackFirst) acknowledge();
+    acpChatSessionActions.addPendingLocalSteerMessage('echo-race', localMessage('steer-1', 'hello', true));
+    if (!ackFirst) acknowledge();
+    acpChatSessionActions.applyAcpSessionNotification(chunk('echo-race', 'steer-1', 'hel', true));
+    const partial = acpChatSessionStore.getSnapshot('echo-race')!;
+    acpChatSessionActions.setMessages('echo-race', partial.messages);
+    const result = acpChatSessionActions.applyAcpSessionNotification(chunk('echo-race', 'steer-1', 'lo', true));
+    expect(result.messages).toHaveLength(1);
+    expect(result.messages[0].content).toEqual([{ type: 'text', text: 'hello' }]);
+  });
+
+  it('keeps repeated text deltas when they are genuinely part of the message', () => {
+    const adapter = createAcpSessionNotificationAdapter([localMessage('steer-1', 'go go', true)]);
+    adapter.apply(chunk('echo-race', 'steer-1', 'go ', true));
+    adapter.apply(chunk('echo-race', 'steer-1', 'go', true));
+    expect(adapter.getMessages()[0].content).toEqual([{ type: 'text', text: 'go go' }]);
+  });
+});
