+import { describe, it, expect, vi } from 'vitest';
+import { render, screen, fireEvent } from '@testing-library/react';
+import { IntlTestWrapper } from '../../i18n/test-utils';
+import JsonSchemaForm, { type JsonSchema } from './JsonSchemaForm';
+
+const choices = ['Deny', 'Allow for this call', 'Allow for 15 minutes', 'Allow for this session'];
+const schema: JsonSchema = {
+  type: 'object',
+  properties: { decision: { type: 'string', title: 'Decision', enum: choices } },
+  required: ['decision'],
+};
+
+describe('single-choice forms', () => {
+  it.each(choices)('submits the exact choice %s directly', (choice) => {
+    const submit = vi.fn();
+    render(<JsonSchemaForm schema={schema} onSubmit={submit} />, { wrapper: IntlTestWrapper });
+    expect(screen.queryByRole('combobox')).not.toBeInTheDocument();
+    expect(screen.queryByRole('button', { name: 'Submit' })).not.toBeInTheDocument();
+    expect(submit).not.toHaveBeenCalled();
+    fireEvent.click(screen.getByRole('button', { name: choice }));
+    expect(submit).toHaveBeenCalledExactlyOnceWith({ decision: choice });
+  });
+
+  it('disables every choice while a response is being submitted', () => {
+    const submit = vi.fn();
+    render(<JsonSchemaForm schema={schema} onSubmit={submit} disabled />, { wrapper: IntlTestWrapper });
+    for (const choice of choices) {
+      const button = screen.getByRole('button', { name: choice });
+      expect(button).toBeDisabled();
+      fireEvent.click(button);
+    }
+    expect(submit).not.toHaveBeenCalled();
+  });
+
+  it('preserves validation for the chosen value', () => {
+    const submit = vi.fn();
+    const constrained = { ...schema, properties: { decision: { ...schema.properties!.decision, minLength: 5 } } };
+    render(<JsonSchemaForm schema={constrained} onSubmit={submit} />, { wrapper: IntlTestWrapper });
+    fireEvent.click(screen.getByRole('button', { name: 'Deny' }));
+    expect(screen.getByRole('alert')).toBeInTheDocument();
+    expect(submit).not.toHaveBeenCalled();
+  });
+
+  it('keeps the normal form for multiple fields', () => {
+    const multiple = { ...schema, properties: { ...schema.properties, reason: { type: 'string' } } };
+    render(<JsonSchemaForm schema={multiple} onSubmit={vi.fn()} />, { wrapper: IntlTestWrapper });
+    expect(screen.getByRole('combobox')).toBeInTheDocument();
+    expect(screen.getByRole('button', { name: 'Submit' })).toBeInTheDocument();
+  });
+
+  it('keeps the normal form for an optional choice', () => {
+    render(<JsonSchemaForm schema={{ ...schema, required: [] }} onSubmit={vi.fn()} />, { wrapper: IntlTestWrapper });
+    expect(screen.getByRole('combobox')).toBeInTheDocument();
+  });
+});
