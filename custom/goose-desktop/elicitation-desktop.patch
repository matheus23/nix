+async function notifyElicitation(): Promise<void> {
+  try {
+    const [enabled, focused] = await Promise.all([
+      window.electron.getSetting('enableNotifications'),
+      window.electron.isAnyWindowFocused(),
+    ]);
+    if (enabled === true && !focused) {
+      window.electron.showNotification({
+        title: 'Goose needs your approval',
+        body: 'An extension is waiting for your response. The request expires after five minutes.',
+      });
+    }
+  } catch (error) {
+    console.warn('Could not notify about an elicitation request:', error);
+  }
